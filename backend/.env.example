# Un solo proceso Uvicorn. Valores para pruebas privadas del equipo.
ASSET_FINDER_AI_DEVICE=cpu
ASSET_FINDER_AI_THREADS=2
ASSET_FINDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcionales: por defecto se usa data/ dentro del repositorio.
# ASSET_FINDER_MEDIA_DIR=/ruta/asset-finder/media
# ASSET_FINDER_JOBS_DIR=/ruta/asset-finder/jobs
